{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "tier_h_discrete",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.005",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_tier_h_discrete",
      "kind": "program",
      "name": "tier_h_discrete",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src", "kind": "signal_constant",
          "data": { "params": { "value": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "di", "kind": "signal_discrete_integrator",
          "data": { "log_signal": true,
                    "params": { "method": "ForwardEuler",
                                "initialCondition": 0.0,
                                "sampleTime": 0.1 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "tier_h_discrete" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src", "port": "out"}, "to": {"node": "di",    "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "di",  "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
