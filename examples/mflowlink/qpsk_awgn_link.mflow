      { "id": "dem", "kind": "signal_psk_demod", "data": { "params": { "M": 4 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
      { "id": "ber", "kind": "signal_error_rate", "data": { "params": { "tolerance": 0.5 } }, "ports": { "in": [{"id": "tx"}, {"id": "rx"}], "out": [{"id": "out"}] } },
      { "id": "sb", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } },

      { "id": "c0", "kind": "signal_constant", "data": { "params": { "value": 0.0 } }, "ports": { "in": [], "out": [{"id": "out"}] } },
      { "id": "mod0", "kind": "signal_psk_mod", "data": { "params": { "M": 4 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
      { "id": "ch0", "kind": "signal_awgn", "data": { "params": { "snr": 10.0, "signalPower": 1.0, "seed": 9.0 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
      { "id": "sc", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } },

      { "id": "chanLo", "kind": "signal_awgn", "data": { "params": { "snr": 0.0, "signalPower": 1.0, "seed": 3.0 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
      { "id": "demLo", "kind": "signal_psk_demod", "data": { "params": { "M": 4 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
      { "id": "berLo", "kind": "signal_error_rate", "data": { "params": { "tolerance": 0.5 } }, "ports": { "in": [{"id": "tx"}, {"id": "rx"}], "out": [{"id": "out"}] } },
      { "id": "sl", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } }
    ],
    "edges": [
      { "id": "e0", "kind": "data", "from": {"node": "clk", "port": "out"}, "to": {"node": "cnt", "port": "clk"} },
      { "id": "e1", "kind": "data", "from": {"node": "cnt", "port": "out"}, "to": {"node": "mod", "port": "in"} },
      { "id": "e2", "kind": "data", "from": {"node": "mod", "port": "out"}, "to": {"node": "chan", "port": "in"} },
      { "id": "e3", "kind": "data", "from": {"node": "chan", "port": "out"}, "to": {"node": "dem", "port": "in"} },
      { "id": "e4", "kind": "data", "from": {"node": "cnt", "port": "out"}, "to": {"node": "ber", "port": "tx"} },
