{
  "schema": "matforge.flowchart", "version": "0.1.0", "entry": "qpsk_link",
  "settings": { "kind": "signal_flow",
    "solver": { "type": "fixed_step", "algorithm": "ode4", "startTime": 0.0, "stopTime": 10.0, "maxStep": "0.05" } },
  "flows": [{
    "id": "flow_link", "kind": "function", "name": "qpsk_link",
    "signature": { "inputs": [], "outputs": [] },
    "nodes": [
      { "id": "clk", "kind": "signal_pulse", "data": { "params": { "amplitude": 1.0, "period": 0.5, "pulseWidth": 50.0, "phaseDelay": 0.0 } }, "ports": { "in": [], "out": [{"id": "out"}] } },
      { "id": "cnt", "kind": "signal_counter", "data": { "params": { "initialValue": 0.0, "step": 1.0, "modulus": 4.0 } }, "ports": { "in": [{"id": "clk"}], "out": [{"id": "out"}] } },
      { "id": "mod", "kind": "signal_psk_mod", "data": { "params": { "M": 4 } }, "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
