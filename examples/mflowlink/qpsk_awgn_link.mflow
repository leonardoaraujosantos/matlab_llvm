      { "id": "e6", "kind": "data", "from": {"node": "ber", "port": "out"}, "to": {"node": "sb", "port": "in"} },
      { "id": "e7", "kind": "data", "from": {"node": "c0", "port": "out"}, "to": {"node": "mod0", "port": "in"} },
      { "id": "e8", "kind": "data", "from": {"node": "mod0", "port": "out"}, "to": {"node": "ch0", "port": "in"} },
      { "id": "e9", "kind": "data", "from": {"node": "ch0", "port": "out"}, "to": {"node": "sc", "port": "in"} },
      { "id": "e10", "kind": "data", "from": {"node": "mod", "port": "out"}, "to": {"node": "chanLo", "port": "in"} },
