            "params" : {
              "function_body" : "function y = harmonic_sum(u1)\n  % Sum the first 5 harmonics of u1 with diminishing amplitude.\n  % Exercises the for loop + accumulator pattern.\n  y = 0;\n  for k = 1:5\n    y = y + sin(k * u1) / k;\n  end\nend\n"
            }
          },
