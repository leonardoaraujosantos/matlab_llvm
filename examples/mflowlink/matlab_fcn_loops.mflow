        },
        {
          "data" : {
            "log_signal" : true,
            "params" : {
              "function_body" : "function y = newton_inverse_sqrt(u1)\n  % Newton iteration: solve x^2 = u1 + 1 for x.\n  % Exercises the while loop + early break pattern.\n  y = 1.0;\n  for it = 1:50\n    if abs(y*y - (u1 + 1)) < 1e-9\n      break\n    end\n    y = 0.5 * (y + (u1 + 1) / y);\n  end\nend\n"
            }
          },
