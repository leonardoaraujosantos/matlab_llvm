{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "threshold_switch",
  "settings": {
    "kind": "signal_flow"
  },
  "flows": [
    {
      "id": "flow_threshold_switch",
      "kind": "function",
      "name": "threshold_switch",
      "signature": { "inputs": ["u_lo", "u_ctrl", "u_hi"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1",   "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "u2",   "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "u3",   "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "pick", "kind": "signal_switch",
          "data": { "params": { "threshold": 0.5 } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}, {"id": "in3"}],
                     "out": [{"id": "out"}] } },

        { "id": "y1",   "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "u1",   "port": "out"},
          "to":   {"node": "pick", "port": "in1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "u2",   "port": "out"},
          "to":   {"node": "pick", "port": "in2"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "u3",   "port": "out"},
          "to":   {"node": "pick", "port": "in3"} },
        { "id": "e4", "kind": "data",
          "from": {"node": "pick", "port": "out"},
          "to":   {"node": "y1",   "port": "in"} }
      ]
    }
  ]
}
