{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "cocotb_multi_dut_sil",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode4",
      "startTime": 0.0,
      "stopTime": 0.3,
      "maxStep": "0.01"
    }
  },
  "flows": [
    {
      "id": "flow_top",
      "kind": "program",
      "name": "cocotb_multi_dut_sil",
      "nodes": [
        { "id": "stim", "kind": "signal_step",
          "data": { "params": { "stepTime": "0.05",
                                "initialValue": "0",
                                "finalValue": "0.25" } },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "gain_a", "kind": "signal_subsystem",
          "data": { "flow_id": "flow_gain_a" },
          "ports": { "in": [{"id": "u1"}], "out": [{"id": "y1"}] } },

        { "id": "gain_b", "kind": "signal_subsystem",
          "data": { "flow_id": "flow_gain_b" },
          "ports": { "in": [{"id": "u1"}], "out": [{"id": "y1"}] } },

        { "id": "scope_a", "kind": "signal_scope",
          "data": { "params": { "title": "ya" } },
          "ports": { "in": [{"id": "in"}], "out": [] } },
        { "id": "scope_b", "kind": "signal_scope",
          "data": { "params": { "title": "yb" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "stim",   "port": "out"},
          "to":   {"node": "gain_a", "port": "u1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "stim",   "port": "out"},
          "to":   {"node": "gain_b", "port": "u1"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "gain_a", "port": "y1"},
          "to":   {"node": "scope_a", "port": "in"} },
        { "id": "e4", "kind": "data",
          "from": {"node": "gain_b", "port": "y1"},
          "to":   {"node": "scope_b", "port": "in"} }
      ]
    },
    {
      "id": "flow_gain_a",
      "kind": "function",
      "name": "gain_a_block",
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "g",  "kind": "signal_gain",
          "data": { "params": { "gain": "2.0" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "y1", "kind": "signal_outport",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "a1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "g",  "port": "in"} },
        { "id": "a2", "kind": "data",
          "from": {"node": "g",  "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    },
    {
      "id": "flow_gain_b",
      "kind": "function",
      "name": "gain_b_block",
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "g",  "kind": "signal_gain",
          "data": { "params": { "gain": "3.0" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "y1", "kind": "signal_outport",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "b1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "g",  "port": "in"} },
        { "id": "b2", "kind": "data",
          "from": {"node": "g",  "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    }
  ]
}
