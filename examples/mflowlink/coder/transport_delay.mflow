{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "transport_delay",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode4",
      "startTime": 0.0,
      "stopTime": 1.0,
      "maxStep": "0.05"
    }
  },
  "flows": [
    {
      "id": "flow_transport_delay",
      "kind": "function",
      "name": "transport_delay",
      "signature": { "inputs": ["u"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "delay", "kind": "signal_transport_delay",
          "data": {
            "params": { "delay": "0.2" }
          },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "y1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "delay", "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "delay", "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    }
  ]
}
