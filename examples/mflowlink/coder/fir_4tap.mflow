        { "id": "e_k0_sum", "kind": "data",
          "from": {"node": "k0", "port": "out"},
          "to":   {"node": "sum", "port": "in1"} },
        { "id": "e_k1_sum", "kind": "data",
          "from": {"node": "k1", "port": "out"},
          "to":   {"node": "sum", "port": "in2"} },
        { "id": "e_k2_sum", "kind": "data",
          "from": {"node": "k2", "port": "out"},
