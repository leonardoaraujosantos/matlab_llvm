        { "id": "e_d2_d3", "kind": "data",
          "from": {"node": "d2", "port": "out"},
          "to":   {"node": "d3", "port": "in"} },

        { "id": "e_u_k0", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "k0", "port": "in"} },
        { "id": "e_d1_k1", "kind": "data",
          "from": {"node": "d1", "port": "out"},
          "to":   {"node": "k1", "port": "in"} },
        { "id": "e_d2_k2", "kind": "data",
          "from": {"node": "d2", "port": "out"},
          "to":   {"node": "k2", "port": "in"} },
        { "id": "e_d3_k3", "kind": "data",
