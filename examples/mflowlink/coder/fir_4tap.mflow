{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "fir_4tap",
  "settings": {
    "kind": "signal_flow"
  },
  "flows": [
    {
      "id": "flow_fir_4tap",
      "kind": "function",
      "name": "fir_4tap",
      "signature": { "inputs": ["u"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "d1", "kind": "signal_unit_delay",
          "data": { "params": { "initialCondition": 0.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "d2", "kind": "signal_unit_delay",
          "data": { "params": { "initialCondition": 0.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "d3", "kind": "signal_unit_delay",
          "data": { "params": { "initialCondition": 0.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "k0", "kind": "signal_gain",
          "data": { "params": { "gain": 0.25 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "k1", "kind": "signal_gain",
          "data": { "params": { "gain": 0.25 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "k2", "kind": "signal_gain",
          "data": { "params": { "gain": 0.25 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "k3", "kind": "signal_gain",
          "data": { "params": { "gain": 0.25 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "sum", "kind": "signal_sum",
          "data": { "params": { "signs": "++++" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"},
                            {"id": "in3"}, {"id": "in4"}],
                     "out": [{"id": "out"}] } },

        { "id": "y1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_u_d1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "d1", "port": "in"} },
        { "id": "e_d1_d2", "kind": "data",
          "from": {"node": "d1", "port": "out"},
