{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "multirate_filters",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode4",
      "startTime": 0.0,
      "stopTime": 5.0,
      "maxStep": "0.01"
    }
  },
  "flows": [
    {
      "id": "flow_mr",
      "kind": "function",
      "name": "multirate_filters",
      "signature": { "inputs": ["u"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "fast", "kind": "signal_unit_delay",
          "data": { "params": { "sampleTime": 0.01 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "slow", "kind": "signal_unit_delay",
          "data": { "params": { "sampleTime": 0.05 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "sum", "kind": "signal_sum",
          "data": { "params": { "signs": "++" } },
          "ports": { "in": [{"id":"in1"},{"id":"in2"}],
                     "out": [{"id":"out"}] } },

        { "id": "y1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "fast", "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "slow", "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "fast", "port": "out"},
          "to":   {"node": "sum", "port": "in1"} },
        { "id": "e4", "kind": "data",
          "from": {"node": "slow", "port": "out"},
          "to":   {"node": "sum", "port": "in2"} },
        { "id": "e5", "kind": "data",
          "from": {"node": "sum", "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    }
  ]
}
