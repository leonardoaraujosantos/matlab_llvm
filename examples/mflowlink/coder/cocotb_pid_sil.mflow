{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "cocotb_pid_sil",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode4",
      "startTime": 0.0,
      "stopTime": 0.5,
      "maxStep": "0.01"
    }
  },
  "flows": [
    {
      "id": "flow_top",
      "kind": "program",
      "name": "cocotb_pid_sil",
      "nodes": [
        { "id": "stim",  "kind": "signal_step",
          "data": { "params": { "stepTime": "0.1",
                                "initialValue": "0",
                                "finalValue": "0.5" } },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "plant_dut", "kind": "signal_subsystem",
          "data": { "flow_id": "flow_plant" },
          "ports": { "in": [{"id": "u1"}], "out": [{"id": "y1"}] } },

        { "id": "scope_stim", "kind": "signal_scope",
          "data": { "params": { "title": "u" } },
          "ports": { "in": [{"id": "in"}], "out": [] } },
        { "id": "scope_plant", "kind": "signal_scope",
          "data": { "params": { "title": "y" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "stim", "port": "out"},
          "to":   {"node": "plant_dut", "port": "u1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "stim", "port": "out"},
          "to":   {"node": "scope_stim", "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "plant_dut", "port": "y1"},
          "to":   {"node": "scope_plant", "port": "in"} }
      ]
    },
    {
      "id": "flow_plant",
      "kind": "function",
      "name": "plant",
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "g",  "kind": "signal_gain",
          "data": { "params": { "gain": "2.0" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "y1", "kind": "signal_outport",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "p1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "g",  "port": "in"} },
        { "id": "p2", "kind": "data",
          "from": {"node": "g",  "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    }
  ]
}
