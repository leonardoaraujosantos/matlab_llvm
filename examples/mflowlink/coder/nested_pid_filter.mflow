{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "outer_loop",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode4",
      "startTime": 0.0,
      "stopTime": 5.0,
      "maxStep": "0.05"
    }
  },
  "flows": [
    {
      "id": "flow_outer",
      "kind": "function",
      "name": "outer_loop",
      "signature": { "inputs": ["u"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "lp", "kind": "signal_subsystem",
          "data": { "flow_id": "flow_lp" },
          "ports": {
            "in":  [{"id": "in"}],
            "out": [{"id": "out"}]
          } },

        { "id": "gain", "kind": "signal_gain",
          "data": { "params": { "gain": "2" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "y1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "u1", "port": "out"},
          "to":   {"node": "lp", "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "lp", "port": "out"},
          "to":   {"node": "gain", "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "gain", "port": "out"},
          "to":   {"node": "y1", "port": "in"} }
      ]
    },
    {
      "id": "flow_lp",
      "kind": "function",
      "name": "lp_filter",
      "signature": { "inputs": ["in"], "outputs": ["out"] },
      "nodes": [
        { "id": "in1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "tf", "kind": "signal_transfer_fcn",
          "data": {
            "params": { "num": "1", "den": "1, 1" }
          },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "out1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "le1", "kind": "data",
          "from": {"node": "in1", "port": "out"},
          "to":   {"node": "tf", "port": "in"} },
        { "id": "le2", "kind": "data",
          "from": {"node": "tf", "port": "out"},
          "to":   {"node": "out1", "port": "in"} }
      ]
    }
  ]
}
