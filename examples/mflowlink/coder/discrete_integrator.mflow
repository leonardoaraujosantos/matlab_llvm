{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "discrete_integrator",
  "settings": {
    "kind": "signal_flow"
  },
  "flows": [
    {
      "id": "flow_discrete_integrator",
      "kind": "function",
      "name": "discrete_integrator",
      "signature": { "inputs": ["u"], "outputs": ["y"] },
      "nodes": [
        { "id": "u1", "kind": "signal_inport",
          "data": { "params": {} },
          "ports": { "in": [], "out": [{"id": "out"}] } },

        { "id": "g",  "kind": "signal_gain",
          "data": { "params": { "gain": 0.5 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "acc", "kind": "signal_discrete_integrator",
          "data": { "params": { "Ts": 0.1, "method": "ForwardEuler" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },

        { "id": "y1", "kind": "signal_outport",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "u1",  "port": "out"},
          "to":   {"node": "g",   "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "g",   "port": "out"},
          "to":   {"node": "acc", "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "acc", "port": "out"},
          "to":   {"node": "y1",  "port": "in"} }
      ]
    }
  ]
}
