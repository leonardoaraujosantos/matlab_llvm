            "log_signal" : true,
            "params" : {
              "function_body" : "function y = soft_mix(u1, u2)\n  % Soft-saturated mixer with deadband.\n  % Combines two inputs, applies a ±0.2 deadband around zero,\n  % and softly clips above ±1 with a 10x compression ratio.\n  s = u1 + u2;\n  abs_s = abs(s);\n  if abs_s < 0.2\n    y = 0;\n  elseif s > 1.0\n    y = 1 + 0.1 * (s - 1);\n  elseif s < -1.0\n    y = -1 + 0.1 * (s + 1);\n  else\n    y = s;\n  end\nend\n"
            }
          },
