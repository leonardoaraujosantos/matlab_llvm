{
  "schema": "matforge.flowchart", "version": "0.1.0", "entry": "hdl_shift_register",
  "settings": { "kind": "signal_flow",
    "solver": { "type": "fixed_step", "algorithm": "ode4", "startTime": 0.0, "stopTime": 8.0, "maxStep": "0.05" } },
  "flows": [{
    "id": "flow_sr", "kind": "function", "name": "hdl_shift_register",
    "signature": { "inputs": [], "outputs": [] },
    "comment": "3-stage D flip-flop shift register. A serial input bit (high for ~1 clock) shifts through FF1->FF2->FF3, one stage per clock posedge — q3 lights up ~3 clocks after the input.",
    "nodes": [
      { "id": "clk", "kind": "signal_pulse", "data": { "params": { "amplitude": 1.0, "period": 1.0, "pulseWidth": 50.0, "phaseDelay": 0.0 } }, "ports": { "in": [], "out": [{"id": "out"}] } },
      { "id": "din", "kind": "signal_pulse", "data": { "params": { "amplitude": 1.0, "period": 8.0, "pulseWidth": 18.0, "phaseDelay": 0.0 } }, "ports": { "in": [], "out": [{"id": "out"}] } },
      { "id": "ff1", "kind": "signal_dff", "data": { "params": { "initialValue": 0.0 } }, "ports": { "in": [{"id": "d"}, {"id": "clk"}], "out": [{"id": "out"}] } },
      { "id": "ff2", "kind": "signal_dff", "data": { "params": { "initialValue": 0.0 } }, "ports": { "in": [{"id": "d"}, {"id": "clk"}], "out": [{"id": "out"}] } },
      { "id": "ff3", "kind": "signal_dff", "data": { "params": { "initialValue": 0.0 } }, "ports": { "in": [{"id": "d"}, {"id": "clk"}], "out": [{"id": "out"}] } },
      { "id": "q1", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } },
      { "id": "q2", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } },
      { "id": "q3", "kind": "signal_scope", "data": { "params": {} }, "ports": { "in": [{"id": "in"}], "out": [] } }
    ],
    "edges": [
      { "id": "c1", "kind": "data", "from": {"node": "clk", "port": "out"}, "to": {"node": "ff1", "port": "clk"} },
      { "id": "c2", "kind": "data", "from": {"node": "clk", "port": "out"}, "to": {"node": "ff2", "port": "clk"} },
      { "id": "c3", "kind": "data", "from": {"node": "clk", "port": "out"}, "to": {"node": "ff3", "port": "clk"} },
      { "id": "d1", "kind": "data", "from": {"node": "din", "port": "out"}, "to": {"node": "ff1", "port": "d"} },
      { "id": "d2", "kind": "data", "from": {"node": "ff1", "port": "out"}, "to": {"node": "ff2", "port": "d"} },
      { "id": "d3", "kind": "data", "from": {"node": "ff2", "port": "out"}, "to": {"node": "ff3", "port": "d"} },
      { "id": "o1", "kind": "data", "from": {"node": "ff1", "port": "out"}, "to": {"node": "q1", "port": "in"} },
      { "id": "o2", "kind": "data", "from": {"node": "ff2", "port": "out"}, "to": {"node": "q2", "port": "in"} },
      { "id": "o3", "kind": "data", "from": {"node": "ff3", "port": "out"}, "to": {"node": "q3", "port": "in"} }
    ]
  }]
