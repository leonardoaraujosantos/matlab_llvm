{ "schema": "matforge.flowchart", "version": "0.1.0", "entry": "net_stream_orbit",
  "settings": { "kind": "signal_flow", "solver": { "type": "fixed_step", "algorithm": "ode4", "startTime": 0.0, "stopTime": 6.283185307179586, "maxStep": "0.05" } },
