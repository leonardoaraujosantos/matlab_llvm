        { "id" : "tree", "kind" : "signal_actor3d", "data" : { "params" : { "name" : "tree", "shape" : "cylinder", "radius" : 0.5, "height" : 4, "translation" : "3,0,2", "semanticLabel" : 5, "color" : "0.3,0.6,0.3" } }, "ports" : { "in" : [] } },
        { "id" : "lidar", "kind" : "signal_sensor3d", "data" : { "log_signal" : true, "params" : { "kind" : "lidar", "azimuth" : 24, "follow" : "rover", "offset" : "0,0,0.3", "target" : "1,0,0", "range" : 30, "ground" : 0, "noise" : 0.02, "seed" : 7 } }, "ports" : { "in" : [], "out" : [ { "id" : "out" } ] } }
