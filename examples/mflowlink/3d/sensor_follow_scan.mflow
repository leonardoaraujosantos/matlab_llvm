{
  "entry" : "sensor_follow_scan",
  "flows" : [
    {
      "edges" : [
        { "id" : "ex", "kind" : "data", "from" : { "node" : "px", "port" : "out" }, "to" : { "node" : "pos", "port" : "in1" } },
        { "id" : "ey", "kind" : "data", "from" : { "node" : "zero", "port" : "out" }, "to" : { "node" : "pos", "port" : "in2" } },
        { "id" : "ez", "kind" : "data", "from" : { "node" : "one", "port" : "out" }, "to" : { "node" : "pos", "port" : "in3" } },
        { "id" : "ep", "kind" : "data", "from" : { "node" : "pos", "port" : "out" }, "to" : { "node" : "rover", "port" : "translation" } }
      ],
      "id" : "flow_sfs", "kind" : "program", "name" : "sensor_follow_scan",
      "nodes" : [
        { "id" : "world", "kind" : "signal_world3d", "data" : { "params" : { "viewpoint" : "8,8,5", "showGround" : true, "output" : "sensor_follow_scan.html" } }, "ports" : { "in" : [], "out" : [] } },
        { "id" : "zero", "kind" : "signal_constant", "data" : { "params" : { "value" : 0.0 } }, "ports" : { "in" : [], "out" : [ { "id" : "out" } ] } },
        { "id" : "one", "kind" : "signal_constant", "data" : { "params" : { "value" : 0.5 } }, "ports" : { "in" : [], "out" : [ { "id" : "out" } ] } },
        { "id" : "px", "kind" : "signal_ramp", "data" : { "params" : { "slope" : 0.5, "initialOutput" : -3.0 } }, "ports" : { "in" : [], "out" : [ { "id" : "out" } ] } },
        { "id" : "pos", "kind" : "signal_mux", "data" : { "params" : {} }, "ports" : { "in" : [ { "id" : "in1" }, { "id" : "in2" }, { "id" : "in3" } ], "out" : [ { "id" : "out" } ] } },
