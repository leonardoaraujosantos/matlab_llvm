<?xml version="1.0"?>
<robot name="arm2">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.4" length="0.2"/></geometry>
    </visual>
  </link>
  <link name="link1">
    <visual>
      <origin xyz="0.75 0 0" rpy="0 0 0"/>
      <geometry><box size="1.5 0.25 0.25"/></geometry>
    </visual>
  </link>
  <link name="link2">
    <visual>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry><box size="1.2 0.2 0.2"/></geometry>
    </visual>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
