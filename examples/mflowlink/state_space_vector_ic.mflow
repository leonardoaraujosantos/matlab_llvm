{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "osc_ic",
  "settings": {
    "kind": "signal_flow",
    "solver": { "type": "fixed_step", "algorithm": "ode4",
                "startTime": 0.0, "stopTime": 1.0, "maxStep": "0.01" }
  },
  "flows": [
    {
      "id": "flow_osc", "kind": "function", "name": "osc_ic",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "plant", "kind": "signal_state_space",
          "data": { "params": {
            "A": "0 1; -1 0", "B": "0; 0", "C": "1 0; 0 1", "x0": "2; 0" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out1"}, {"id": "out2"}] } },
        { "id": "pos", "kind": "signal_scope",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } },
        { "id": "vel", "kind": "signal_scope",
          "data": { "params": {} },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data", "from": {"node": "plant", "port": "out1"}, "to": {"node": "pos", "port": "in"} },
        { "id": "e2", "kind": "data", "from": {"node": "plant", "port": "out2"}, "to": {"node": "vel", "port": "in"} }
      ]
    }
  ]
}
