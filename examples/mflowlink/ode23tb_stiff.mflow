{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "ode23tb_stiff",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "fixed_step",
      "algorithm": "ode23tb",
      "startTime": 0.0,
      "stopTime": 5.0,
      "maxStep": "0.1",
      "relTol": 1e-4,
      "absTol": 1e-7,
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_stiff",
      "kind": "program",
      "name": "ode23tb_stiff",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "drive", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 100.0, "bias": 0.0,
                                "frequency": 1.0, "phase": 1.5707963 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "plant", "kind": "signal_transfer_fcn",
          "data": { "log_signal": true,
                    "params": { "num": "1", "den": "0.0001, 1" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "stiff ode23tb" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "drive", "port": "out"}, "to": {"node": "plant", "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "plant", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
