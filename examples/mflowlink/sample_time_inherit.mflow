{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "inherit_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 1.0,
      "maxStep": "0.005",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_inherit",
      "kind": "program",
      "name": "inherit_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 1.0, "frequency": 6.2831853 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "zoh", "kind": "signal_zoh",
          "data": { "log_signal": true,
                    "params": { "sampleTime": 0.1 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "gain", "kind": "signal_gain",
          "data": { "log_signal": true,
                    "sample_time": "inherited",
                    "params": { "gain": 3.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "inherited" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src",  "port": "out"}, "to": {"node": "zoh",   "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "zoh",  "port": "out"}, "to": {"node": "gain",  "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "gain", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
