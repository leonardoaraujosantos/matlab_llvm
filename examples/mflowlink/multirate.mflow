{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "multirate",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.005",
      "relTol": 1e-3,
      "absTol": 1e-6,
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_mr",
      "kind": "program",
      "name": "multirate",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 1.0, "bias": 0.0,
                                "frequency": 6.2831853, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "zoh", "kind": "signal_zoh",
          "data": { "log_signal": true,
                    "params": { "sampleTime": 0.1 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "plant", "kind": "signal_transfer_fcn",
          "data": { "log_signal": true,
                    "params": { "num": "1", "den": "1, 1" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "multirate" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src",   "port": "out"}, "to": {"node": "zoh",   "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "zoh",   "port": "out"}, "to": {"node": "plant", "port": "in"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "plant", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
