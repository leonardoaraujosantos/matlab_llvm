{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "fir_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_fir",
      "kind": "program",
      "name": "fir_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "step", "kind": "signal_step",
          "data": { "log_signal": true,
                    "params": { "stepTime": 0.1, "initialValue": 0.0,
                                "finalValue": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "ma3", "kind": "signal_discrete_filter",
          "data": { "log_signal": true,
                    "params": { "num": "0.3333333, 0.3333333, 0.3333333",
                                "den": "1",
                                "sampleTime": 0.05 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "FIR moving-average" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "step", "port": "out"}, "to": {"node": "ma3", "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "ma3",  "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
