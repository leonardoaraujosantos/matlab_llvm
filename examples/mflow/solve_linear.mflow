{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "settings": {
    "columnMajor": true,
    "defaultNumericType": "double",
    "sourceLanguage": "matforge"
  },
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "s",     "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "matA",  "kind": "matrix_literal",
          "data": { "name": "A", "rows": "2 1 1; 1 3 2; 1 1 1" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "matB",  "kind": "matrix_literal",
          "data": { "name": "b", "rows": "5; 10; 6" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "solve", "kind": "assignment",
          "data": { "lhs": "x", "rhs": "A \\ b" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblA",  "kind": "display",
          "data": { "expression": "'A ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showA", "kind": "display",
          "data": { "expression": "A" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblB",  "kind": "display",
          "data": { "expression": "'b ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showB", "kind": "display",
          "data": { "expression": "b" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblX",  "kind": "display",
          "data": { "expression": "'x = A \\ b ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showX", "kind": "display",
          "data": { "expression": "x" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblV",  "kind": "display",
          "data": { "expression": "'A * x ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showV", "kind": "display",
          "data": { "expression": "A * x" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",     "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1",  "kind": "control",
          "from": {"node": "s",     "port": "out"}, "to": {"node": "matA",  "port": "in"} },
        { "id": "e_2",  "kind": "control",
          "from": {"node": "matA",  "port": "out"}, "to": {"node": "matB",  "port": "in"} },
        { "id": "e_3",  "kind": "control",
          "from": {"node": "matB",  "port": "out"}, "to": {"node": "solve", "port": "in"} },
        { "id": "e_4",  "kind": "control",
          "from": {"node": "solve", "port": "out"}, "to": {"node": "lblA",  "port": "in"} },
        { "id": "e_5",  "kind": "control",
          "from": {"node": "lblA",  "port": "out"}, "to": {"node": "showA", "port": "in"} },
        { "id": "e_6",  "kind": "control",
          "from": {"node": "showA", "port": "out"}, "to": {"node": "lblB",  "port": "in"} },
        { "id": "e_7",  "kind": "control",
          "from": {"node": "lblB",  "port": "out"}, "to": {"node": "showB", "port": "in"} },
        { "id": "e_8",  "kind": "control",
          "from": {"node": "showB", "port": "out"}, "to": {"node": "lblX",  "port": "in"} },
        { "id": "e_9",  "kind": "control",
          "from": {"node": "lblX",  "port": "out"}, "to": {"node": "showX", "port": "in"} },
        { "id": "e_10", "kind": "control",
          "from": {"node": "showX", "port": "out"}, "to": {"node": "lblV",  "port": "in"} },
        { "id": "e_11", "kind": "control",
          "from": {"node": "lblV",  "port": "out"}, "to": {"node": "showV", "port": "in"} },
        { "id": "e_12", "kind": "control",
          "from": {"node": "showV", "port": "out"}, "to": {"node": "e",     "port": "in"} }
      ]
    }
  ]
}
