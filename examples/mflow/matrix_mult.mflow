{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "settings": {
    "columnMajor": true,
    "defaultNumericType": "double",
    "sourceLanguage": "matforge"
  },
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "s",     "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "matA",  "kind": "matrix_literal",
          "data": { "name": "A", "rows": "1 2 3; 4 5 6; 7 8 10" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "matB",  "kind": "matrix_literal",
          "data": { "name": "B", "rows": "1 0 0; 0 2 0; 0 0 3" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblA",  "kind": "display",
          "data": { "expression": "'A ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showA", "kind": "display",
          "data": { "expression": "A" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblB",  "kind": "display",
          "data": { "expression": "'B ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showB", "kind": "display",
          "data": { "expression": "B" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblM",  "kind": "display",
          "data": { "expression": "'A * B ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showM", "kind": "display",
          "data": { "expression": "A * B" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblE",  "kind": "display",
          "data": { "expression": "'A .* B ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showE", "kind": "display",
          "data": { "expression": "A .* B" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lblT",  "kind": "display",
          "data": { "expression": "'A'' ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "showT", "kind": "display",
          "data": { "expression": "A'" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",     "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1",  "kind": "control",
          "from": {"node": "s",     "port": "out"}, "to": {"node": "matA",  "port": "in"} },
        { "id": "e_2",  "kind": "control",
          "from": {"node": "matA",  "port": "out"}, "to": {"node": "matB",  "port": "in"} },
        { "id": "e_3",  "kind": "control",
          "from": {"node": "matB",  "port": "out"}, "to": {"node": "lblA",  "port": "in"} },
        { "id": "e_4",  "kind": "control",
          "from": {"node": "lblA",  "port": "out"}, "to": {"node": "showA", "port": "in"} },
        { "id": "e_5",  "kind": "control",
          "from": {"node": "showA", "port": "out"}, "to": {"node": "lblB",  "port": "in"} },
        { "id": "e_6",  "kind": "control",
          "from": {"node": "lblB",  "port": "out"}, "to": {"node": "showB", "port": "in"} },
        { "id": "e_7",  "kind": "control",
          "from": {"node": "showB", "port": "out"}, "to": {"node": "lblM",  "port": "in"} },
        { "id": "e_8",  "kind": "control",
          "from": {"node": "lblM",  "port": "out"}, "to": {"node": "showM", "port": "in"} },
        { "id": "e_9",  "kind": "control",
          "from": {"node": "showM", "port": "out"}, "to": {"node": "lblE",  "port": "in"} },
        { "id": "e_10", "kind": "control",
          "from": {"node": "lblE",  "port": "out"}, "to": {"node": "showE", "port": "in"} },
        { "id": "e_11", "kind": "control",
          "from": {"node": "showE", "port": "out"}, "to": {"node": "lblT",  "port": "in"} },
        { "id": "e_12", "kind": "control",
          "from": {"node": "lblT",  "port": "out"}, "to": {"node": "showT", "port": "in"} },
        { "id": "e_13", "kind": "control",
          "from": {"node": "showT", "port": "out"}, "to": {"node": "e",     "port": "in"} }
      ]
    }
  ]
}
