{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "settings": {
    "columnMajor": true,
    "defaultNumericType": "double",
    "sourceLanguage": "matforge"
  },
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "s",    "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "init", "kind": "variable",
          "data": { "name": "total", "value": "0" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "for1", "kind": "for",
          "data": { "var": "i", "iter": "1:10" },
          "ports": { "in": [{"id": "in"}],
                     "out": [{"id": "body"}, {"id": "done"}] } },
        { "id": "step", "kind": "expression",
          "data": { "expression": "total = total + i" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "lbl",  "kind": "display",
          "data": { "expression": "'sum(1..10) ='" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "show", "kind": "display",
          "data": { "expression": "total" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",    "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",    "port": "out"},  "to": {"node": "init", "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "init", "port": "out"},  "to": {"node": "for1", "port": "in"} },
        { "id": "e_3", "kind": "control",
          "from": {"node": "for1", "port": "body"}, "to": {"node": "step", "port": "in"} },
        { "id": "e_4", "kind": "control",
          "from": {"node": "step", "port": "out"},  "to": {"node": "for1", "port": "in"} },
        { "id": "e_5", "kind": "control",
          "from": {"node": "for1", "port": "done"}, "to": {"node": "lbl",  "port": "in"} },
        { "id": "e_6", "kind": "control",
          "from": {"node": "lbl",  "port": "out"},  "to": {"node": "show", "port": "in"} },
        { "id": "e_7", "kind": "control",
          "from": {"node": "show", "port": "out"},  "to": {"node": "e",    "port": "in"} }
      ]
    }
  ]
}
