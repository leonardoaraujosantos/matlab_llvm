{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "matlab_fcn_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 4.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_matlab_fcn",
      "kind": "program",
      "name": "matlab_fcn_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src1", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 1.0, "bias": 0.0,
                                "frequency": 3.1415927, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "src2", "kind": "signal_ramp",
          "data": { "log_signal": true,
                    "params": { "slope": 0.5, "startTime": 0.0,
                                "initialOutput": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "fcn", "kind": "signal_matlab_fcn",
          "data": { "log_signal": true,
                    "params": { "expression":
                      "u1 * sin(2*pi*t) + sqrt(abs(u2)) - 1.0" } },
          "ports": { "in":  [{"id": "u1"}, {"id": "u2"}],
                     "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "matlab_fcn" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src1", "port": "out"}, "to": {"node": "fcn",   "port": "u1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "src2", "port": "out"}, "to": {"node": "fcn",   "port": "u2"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "fcn",  "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
