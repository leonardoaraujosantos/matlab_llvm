{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "tier_h_logic",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 4.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_tier_h_logic",
      "kind": "program",
      "name": "tier_h_logic",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src_a", "kind": "signal_step",
          "data": { "params": { "stepTime": 1.0, "initialValue": 0.0,
                                "finalValue": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "src_b", "kind": "signal_step",
          "data": { "params": { "stepTime": 2.0, "initialValue": 0.0,
                                "finalValue": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "and_ab", "kind": "signal_logical",
          "data": { "log_signal": true, "params": { "op": "AND" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "or_ab", "kind": "signal_logical",
          "data": { "log_signal": true, "params": { "op": "OR" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "xor_ab", "kind": "signal_logical",
          "data": { "log_signal": true, "params": { "op": "XOR" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "diff", "kind": "signal_sum",
          "data": { "params": { "signs": "+-" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "rel_lt", "kind": "signal_relop",
          "data": { "log_signal": true, "params": { "op": "<" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "term", "kind": "signal_terminator",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_aa", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "and_ab", "port": "in1"} },
        { "id": "e_ab", "kind": "data",
          "from": {"node": "src_b", "port": "out"}, "to": {"node": "and_ab", "port": "in2"} },
        { "id": "e_oa", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "or_ab",  "port": "in1"} },
        { "id": "e_ob", "kind": "data",
          "from": {"node": "src_b", "port": "out"}, "to": {"node": "or_ab",  "port": "in2"} },
        { "id": "e_xa", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "xor_ab", "port": "in1"} },
        { "id": "e_xb", "kind": "data",
          "from": {"node": "src_b", "port": "out"}, "to": {"node": "xor_ab", "port": "in2"} },
        { "id": "e_da", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "diff",   "port": "in1"} },
        { "id": "e_db", "kind": "data",
          "from": {"node": "src_b", "port": "out"}, "to": {"node": "diff",   "port": "in2"} },
        { "id": "e_la", "kind": "data",
          "from": {"node": "diff",  "port": "out"}, "to": {"node": "rel_lt", "port": "in1"} },
        { "id": "e_lb", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "rel_lt", "port": "in2"} },
        { "id": "e_t",  "kind": "data",
          "from": {"node": "and_ab","port": "out"}, "to": {"node": "term",   "port": "in"} }
      ]
    }
  ]
}
