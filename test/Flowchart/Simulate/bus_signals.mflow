{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "bus_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_bus",
      "kind": "program",
      "name": "bus_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "height_src", "kind": "signal_ramp",
          "data": { "log_signal": true,
                    "params": { "slope": 0.5, "startTime": 0.0,
                                "initialOutput": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "velocity_src", "kind": "signal_constant",
          "data": { "log_signal": true,
                    "params": { "value": 9.81 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "temp_src", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 20.0, "bias": 25.0,
                                "frequency": 3.1415927, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "telemetry", "kind": "signal_bus_creator",
          "data": { "log_signal": true,
                    "params": { "field_names": "height,velocity,temperature" } },
          "ports": { "in":  [{"id": "in1"}, {"id": "in2"}, {"id": "in3"}],
                     "out": [{"id": "out"}] } },
        { "id": "pick_temp", "kind": "signal_bus_selector",
          "data": { "log_signal": true,
                    "params": { "field": "temperature" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "pick_height", "kind": "signal_bus_selector",
          "data": { "log_signal": true,
                    "params": { "field": "height" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "term_temp", "kind": "signal_terminator",
          "ports": { "in": [{"id": "in"}], "out": [] } },
        { "id": "term_h", "kind": "signal_terminator",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_h",  "kind": "data",
          "from": {"node": "height_src",   "port": "out"}, "to": {"node": "telemetry", "port": "in1"} },
        { "id": "e_v",  "kind": "data",
          "from": {"node": "velocity_src", "port": "out"}, "to": {"node": "telemetry", "port": "in2"} },
        { "id": "e_t",  "kind": "data",
          "from": {"node": "temp_src",     "port": "out"}, "to": {"node": "telemetry", "port": "in3"} },
        { "id": "e_pt", "kind": "data",
          "from": {"node": "telemetry",    "port": "out"}, "to": {"node": "pick_temp",   "port": "in"} },
        { "id": "e_ph", "kind": "data",
          "from": {"node": "telemetry",    "port": "out"}, "to": {"node": "pick_height", "port": "in"} },
        { "id": "e_sk_temp", "kind": "data",
          "from": {"node": "pick_temp",   "port": "out"}, "to": {"node": "term_temp", "port": "in"} },
        { "id": "e_sk_h",    "kind": "data",
          "from": {"node": "pick_height", "port": "out"}, "to": {"node": "term_h",    "port": "in"} }
      ]
    }
  ]
}
