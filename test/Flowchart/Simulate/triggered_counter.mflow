{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "triggered_counter",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 5.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_triggered_counter",
      "kind": "program",
      "name": "triggered_counter",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "clk", "kind": "signal_function_call_generator",
          "data": { "log_signal": true,
                    "params": { "period": 1.0, "phaseDelay": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "src", "kind": "signal_ramp",
          "data": { "log_signal": true,
                    "params": { "slope": 1.0, "startTime": 0.0,
                                "initialOutput": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "trig", "kind": "signal_triggered_subsystem",
          "data": { "flow_id": "flow_triggered_inner",
                    "enable_block": "clk" },
          "ports": { "in":  [{"id": "in"}],
                     "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "triggered_counter" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src",  "port": "out"}, "to": {"node": "trig",  "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "trig", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    },
    {
      "id": "flow_triggered_inner",
      "kind": "function",
      "name": "triggered_inner",
      "signature": { "inputs": ["in"], "outputs": ["out"] },
      "nodes": [
        { "id": "in_p", "kind": "signal_inport",
          "data": { "port": "in" },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "pass", "kind": "signal_gain",
          "data": { "log_signal": true,
                    "params": { "gain": 1.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "out_p", "kind": "signal_outport",
          "data": { "port": "out" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } }
      ],
      "edges": [
        { "id": "ei1", "kind": "data",
          "from": {"node": "in_p", "port": "out"}, "to": {"node": "pass",  "port": "in"} },
        { "id": "ei2", "kind": "data",
          "from": {"node": "pass", "port": "out"}, "to": {"node": "out_p", "port": "in"} }
      ]
    }
  ]
}
