{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "vec_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_vec_demo",
      "kind": "program",
      "name": "vec_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src_const", "kind": "signal_constant",
          "data": { "log_signal": true,
                    "params": { "value": "[1, 2, 3]" } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "src_sin", "kind": "signal_sine",
          "data": { "params": { "amplitude": 1.0, "bias": 0.0,
                                "frequency": 3.1415927, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "amp", "kind": "signal_gain",
          "data": { "log_signal": true,
                    "params": { "gain": 2.0 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "mux", "kind": "signal_mux",
          "data": { "log_signal": true,
                    "params": { "numInputs": 2 } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "vector_signals" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src_const", "port": "out"}, "to": {"node": "amp",   "port": "in"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "amp",       "port": "out"}, "to": {"node": "mux",   "port": "in1"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "src_sin",   "port": "out"}, "to": {"node": "mux",   "port": "in2"} },
        { "id": "e4", "kind": "data",
          "from": {"node": "mux",       "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
