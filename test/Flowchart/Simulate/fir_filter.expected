MflowLinkModel entry=fir_demo blocks=3 edges=2
  solver type=variable_step algorithm=ode45 startTime=0 stopTime=2
  states continuous=0 discrete=1
  exec-order:
    0 step kind=signal_step sample=fixed_in_minor log
    1 ma3 kind=signal_discrete_filter sample=discrete period=0.05 disc-states=1 loop-breaker log
    2 scope kind=signal_scope sample=fixed_in_minor
  zero-crossings: none
  edges:
    e1 step:out -> ma3:in
    e2 ma3:out -> scope:in
