{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "fn_loops",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 2.0,
      "maxStep": "0.05",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_fn_loops",
      "kind": "program",
      "name": "fn_loops",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "drive", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 1.0, "bias": 0.0,
                                "frequency": 6.2831853, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "harmonic_sum", "kind": "signal_matlab_fcn",
          "data": {
            "log_signal": true,
            "params": {
              "function_body":
                "function y = harmonic_sum(u1)\n  % Sum the first 5 harmonics of u1 with diminishing amplitude.\n  % Exercises the for loop + accumulator pattern.\n  y = 0;\n  for k = 1:5\n    y = y + sin(k * u1) / k;\n  end\nend\n"
            }
          },
          "ports": { "in": [{"id": "u1"}], "out": [{"id": "out"}] } },
        { "id": "convergence", "kind": "signal_matlab_fcn",
          "data": {
            "log_signal": true,
            "params": {
              "function_body":
                "function y = newton_inverse_sqrt(u1)\n  % Newton iteration: solve x^2 = u1 + 1 for x.\n  % Exercises the while loop + early break pattern.\n  y = 1.0;\n  for it = 1:50\n    if abs(y*y - (u1 + 1)) < 1e-9\n      break\n    end\n    y = 0.5 * (y + (u1 + 1) / y);\n  end\nend\n"
            }
          },
          "ports": { "in": [{"id": "u1"}], "out": [{"id": "out"}] } },
        { "id": "scope_h", "kind": "signal_scope",
          "data": { "params": { "title": "harmonic sum" } },
          "ports": { "in": [{"id": "in"}], "out": [] } },
        { "id": "scope_n", "kind": "signal_scope",
          "data": { "params": { "title": "Newton sqrt" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "drive",        "port": "out"}, "to": {"node": "harmonic_sum", "port": "u1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "drive",        "port": "out"}, "to": {"node": "convergence",  "port": "u1"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "harmonic_sum", "port": "out"}, "to": {"node": "scope_h",      "port": "in"} },
        { "id": "e4", "kind": "data",
          "from": {"node": "convergence",  "port": "out"}, "to": {"node": "scope_n",      "port": "in"} }
      ]
    }
  ]
}
