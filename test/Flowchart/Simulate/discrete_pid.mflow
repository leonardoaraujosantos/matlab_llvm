{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "discrete_pid",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 8.0,
      "maxStep": "0.005",
      "relTol": 1e-4,
      "absTol": 1e-7,
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_dpid",
      "kind": "program",
      "name": "discrete_pid",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "ref", "kind": "signal_step",
          "data": { "log_signal": true,
                    "params": { "stepTime": 1.0, "initialValue": 0.0,
                                "finalValue": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "err", "kind": "signal_sum",
          "data": { "params": { "signs": "+-" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "sampler", "kind": "signal_zoh",
          "data": { "log_signal": true,
                    "params": { "sampleTime": 0.05 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "kp", "kind": "signal_gain",
          "data": { "sample_time": "inherited",
                    "params": { "gain": 1.6 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "ki", "kind": "signal_gain",
          "data": { "sample_time": "inherited",
                    "params": { "gain": 0.8 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "i_acc", "kind": "signal_discrete_integrator",
          "data": { "log_signal": true,
                    "params": { "method": "ForwardEuler",
                                "initialCondition": 0.0,
                                "sampleTime": 0.05 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "u_sampled", "kind": "signal_sum",
          "data": { "sample_time": "inherited", "log_signal": true,
                    "params": { "signs": "++" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "u_hold", "kind": "signal_zoh",
          "data": { "params": { "sampleTime": 0.05 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "plant", "kind": "signal_transfer_fcn",
          "data": { "log_signal": true,
                    "params": { "num": "1", "den": "1, 1" } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "discrete PID + cont plant" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_ref",     "kind": "data",
          "from": {"node": "ref",       "port": "out"}, "to": {"node": "err",       "port": "in1"} },
        { "id": "e_fb",      "kind": "data",
          "from": {"node": "plant",     "port": "out"}, "to": {"node": "err",       "port": "in2"} },
        { "id": "e_sample",  "kind": "data",
          "from": {"node": "err",       "port": "out"}, "to": {"node": "sampler",   "port": "in"} },
        { "id": "e_to_kp",   "kind": "data",
          "from": {"node": "sampler",   "port": "out"}, "to": {"node": "kp",        "port": "in"} },
        { "id": "e_to_ki",   "kind": "data",
          "from": {"node": "sampler",   "port": "out"}, "to": {"node": "ki",        "port": "in"} },
        { "id": "e_i_in",    "kind": "data",
          "from": {"node": "ki",        "port": "out"}, "to": {"node": "i_acc",     "port": "in"} },
        { "id": "e_p_term",  "kind": "data",
          "from": {"node": "kp",        "port": "out"}, "to": {"node": "u_sampled", "port": "in1"} },
        { "id": "e_i_term",  "kind": "data",
          "from": {"node": "i_acc",     "port": "out"}, "to": {"node": "u_sampled", "port": "in2"} },
        { "id": "e_u_hold",  "kind": "data",
          "from": {"node": "u_sampled", "port": "out"}, "to": {"node": "u_hold",    "port": "in"} },
        { "id": "e_to_plant","kind": "data",
          "from": {"node": "u_hold",    "port": "out"}, "to": {"node": "plant",     "port": "in"} },
        { "id": "e_scope",   "kind": "data",
          "from": {"node": "plant",     "port": "out"}, "to": {"node": "scope",     "port": "in"} }
      ]
    }
  ]
}
