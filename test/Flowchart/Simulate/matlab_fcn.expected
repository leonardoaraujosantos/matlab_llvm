MflowLinkModel entry=matlab_fcn_demo blocks=4 edges=3
  solver type=variable_step algorithm=ode45 startTime=0 stopTime=4
  states continuous=0 discrete=0
  exec-order:
    0 src1 kind=signal_sine sample=fixed_in_minor log
    1 src2 kind=signal_ramp sample=fixed_in_minor log
    2 fcn kind=signal_matlab_fcn sample=fixed_in_minor log
    3 scope kind=signal_scope sample=fixed_in_minor
  zero-crossings: none
  edges:
    e1 src1:out -> fcn:u1
    e2 src2:out -> fcn:u2
    e3 fcn:out -> scope:in
