{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "fn_demo",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 4.0,
      "maxStep": "0.01",
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_fn_demo",
      "kind": "program",
      "name": "fn_demo",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "src_a", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 1.2, "bias": 0.0,
                                "frequency": 3.1415927, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "src_b", "kind": "signal_sine",
          "data": { "log_signal": true,
                    "params": { "amplitude": 0.3, "bias": 0.0,
                                "frequency": 12.566371, "phase": 0.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "mixer", "kind": "signal_matlab_fcn",
          "data": {
            "log_signal": true,
            "params": {
              "function_body":
                "function y = soft_mix(u1, u2)\n  % Soft-saturated mixer with deadband.\n  % Combines two inputs, applies a ±0.2 deadband around zero,\n  % and softly clips above ±1 with a 10x compression ratio.\n  s = u1 + u2;\n  abs_s = abs(s);\n  if abs_s < 0.2\n    y = 0;\n  elseif s > 1.0\n    y = 1 + 0.1 * (s - 1);\n  elseif s < -1.0\n    y = -1 + 0.1 * (s + 1);\n  else\n    y = s;\n  end\nend\n"
            }
          },
          "ports": { "in":  [{"id": "u1"}, {"id": "u2"}],
                     "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "soft_mix output" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e1", "kind": "data",
          "from": {"node": "src_a", "port": "out"}, "to": {"node": "mixer", "port": "u1"} },
        { "id": "e2", "kind": "data",
          "from": {"node": "src_b", "port": "out"}, "to": {"node": "mixer", "port": "u2"} },
        { "id": "e3", "kind": "data",
          "from": {"node": "mixer", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
