{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "algloop_solved",
  "settings": {
    "kind": "signal_flow",
    "solver": {
      "type": "variable_step",
      "algorithm": "ode45",
      "startTime": 0.0,
      "stopTime": 1.0,
      "maxStep": "0.01",
      "relTol": 1e-6,
      "absTol": 1e-9,
      "zeroCrossing": true,
      "algebraicLoopMethod": "trust_region"
    },
    "snapshot": { "enabled": true, "depth": 256, "fields": "states" }
  },
  "flows": [
    {
      "id": "flow_algloop_solved",
      "kind": "program",
      "name": "algloop_solved",
      "signature": { "inputs": [], "outputs": [] },
      "nodes": [
        { "id": "c", "kind": "signal_constant",
          "data": { "params": { "value": 1.0 } },
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "s", "kind": "signal_sum",
          "data": { "params": { "signs": "+-" } },
          "ports": { "in": [{"id": "in1"}, {"id": "in2"}],
                     "out": [{"id": "out"}] } },
        { "id": "g", "kind": "signal_gain",
          "data": { "log_signal": true,
                    "params": { "gain": 0.5 } },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "scope", "kind": "signal_scope",
          "data": { "params": { "title": "loop solved" } },
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_c", "kind": "data",
          "from": {"node": "c", "port": "out"}, "to": {"node": "s",     "port": "in1"} },
        { "id": "e_s", "kind": "data",
          "from": {"node": "s", "port": "out"}, "to": {"node": "g",     "port": "in"} },
        { "id": "e_fb", "kind": "data",
          "from": {"node": "g", "port": "out"}, "to": {"node": "s",     "port": "in2"} },
        { "id": "e_sc", "kind": "data",
          "from": {"node": "g", "port": "out"}, "to": {"node": "scope", "port": "in"} }
      ]
    }
  ]
}
