{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "nodes": [
        { "id": "s",   "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "in1", "kind": "variable",
          "data": { "name": "even_sum", "value": "0" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "for1", "kind": "for",
          "data": { "var": "i", "iter": "1:10" },
          "ports": { "in": [{"id": "in"}],
                     "out": [{"id": "body"}, {"id": "done"}] } },
        { "id": "if1", "kind": "if",
          "data": { "cond": "mod(i, 2) == 0" },
          "ports": { "in": [{"id": "in"}],
                     "out": [{"id": "true"}, {"id": "false"}] } },
        { "id": "tA", "kind": "expression",
          "data": { "expression": "even_sum = even_sum + i" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "noop", "kind": "comment",
          "data": { "text": "skip odd" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "show", "kind": "display",
          "data": { "expression": "even_sum" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",   "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",    "port": "out"},   "to": {"node": "in1",  "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "in1",  "port": "out"},   "to": {"node": "for1", "port": "in"} },
        { "id": "e_3", "kind": "control",
          "from": {"node": "for1", "port": "body"},  "to": {"node": "if1",  "port": "in"} },
        { "id": "e_4", "kind": "control",
          "from": {"node": "if1",  "port": "true"},  "to": {"node": "tA",   "port": "in"} },
        { "id": "e_5", "kind": "control",
          "from": {"node": "if1",  "port": "false"}, "to": {"node": "noop", "port": "in"} },
        { "id": "e_6", "kind": "control",
          "from": {"node": "tA",   "port": "out"},   "to": {"node": "for1", "port": "in"} },
        { "id": "e_7", "kind": "control",
          "from": {"node": "noop", "port": "out"},   "to": {"node": "for1", "port": "in"} },
        { "id": "e_8", "kind": "control",
          "from": {"node": "for1", "port": "done"},  "to": {"node": "show", "port": "in"} },
        { "id": "e_9", "kind": "control",
          "from": {"node": "show", "port": "out"},   "to": {"node": "e",    "port": "in"} }
      ]
    }
  ]
}
