{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "nodes": [
        { "id": "s",   "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "cb1", "kind": "custom",
          "data": {
            "name": "scale",
            "callee": "scale",
            "args": "10, 4",
            "lhs": "a",
            "library_id": "dsp/scale"
          },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "cb2", "kind": "custom",
          "data": {
            "name": "scale",
            "callee": "scale",
            "args": "a, 2",
            "lhs": "b",
            "library_id": "dsp/scale"
          },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "d1",  "kind": "display",
          "data": { "expression": "b" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",   "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",   "port": "out"}, "to": {"node": "cb1", "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "cb1", "port": "out"}, "to": {"node": "cb2", "port": "in"} },
        { "id": "e_3", "kind": "control",
          "from": {"node": "cb2", "port": "out"}, "to": {"node": "d1",  "port": "in"} },
        { "id": "e_4", "kind": "control",
          "from": {"node": "d1",  "port": "out"}, "to": {"node": "e",   "port": "in"} }
      ]
    }
  ]
}
