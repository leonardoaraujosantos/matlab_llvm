{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "nodes": [
        { "id": "s",  "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "cb", "kind": "custom",
          "data": {
            "name": "clamp",
            "callee": "clamp",
            "args": "42, 0, 10",
            "lhs": "y",
            "path": "blocks/clamp.m"
          },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "d1", "kind": "display",
          "data": { "expression": "y" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",  "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",  "port": "out"}, "to": {"node": "cb", "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "cb", "port": "out"}, "to": {"node": "d1", "port": "in"} },
        { "id": "e_3", "kind": "control",
          "from": {"node": "d1", "port": "out"}, "to": {"node": "e",  "port": "in"} }
      ]
    }
  ]
}
