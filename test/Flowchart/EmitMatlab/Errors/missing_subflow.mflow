{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "nodes": [
        { "id": "s",  "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "sc", "kind": "subflow_call",
          "data": { "flow_id": "flow_does_not_exist", "args": "1", "lhs": "y" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",  "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",  "port": "out"}, "to": {"node": "sc", "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "sc", "port": "out"}, "to": {"node": "e",  "port": "in"} }
      ]
    }
  ]
}
