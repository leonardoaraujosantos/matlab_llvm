{
  "schema": "matforge.flowchart",
  "version": "0.1.0",
  "entry": "main",
  "flows": [
    {
      "id": "flow_main",
      "kind": "program",
      "name": "main",
      "nodes": [
        { "id": "s",   "kind": "start",
          "ports": { "in": [], "out": [{"id": "out"}] } },
        { "id": "v0",  "kind": "variable",
          "data": { "name": "i", "value": "0" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "wh",  "kind": "while",
          "data": { "cond": "true" },
          "ports": { "in": [{"id": "in"}],
                     "out": [{"id": "body"}, {"id": "done"}] } },
        { "id": "step", "kind": "expression",
          "data": { "expression": "i = i + 1" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "if1", "kind": "if",
          "data": { "cond": "i >= 3" },
          "ports": { "in": [{"id": "in"}],
                     "out": [{"id": "true"}, {"id": "false"}] } },
        { "id": "br",  "kind": "break",
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "show", "kind": "display",
          "data": { "expression": "i" },
          "ports": { "in": [{"id": "in"}], "out": [{"id": "out"}] } },
        { "id": "e",   "kind": "end",
          "ports": { "in": [{"id": "in"}], "out": [] } }
      ],
      "edges": [
        { "id": "e_1", "kind": "control",
          "from": {"node": "s",    "port": "out"},   "to": {"node": "v0",   "port": "in"} },
        { "id": "e_2", "kind": "control",
          "from": {"node": "v0",   "port": "out"},   "to": {"node": "wh",   "port": "in"} },
        { "id": "e_3", "kind": "control",
          "from": {"node": "wh",   "port": "body"},  "to": {"node": "step", "port": "in"} },
        { "id": "e_4", "kind": "control",
          "from": {"node": "step", "port": "out"},   "to": {"node": "if1",  "port": "in"} },
        { "id": "e_5", "kind": "control",
          "from": {"node": "if1",  "port": "true"},  "to": {"node": "br",   "port": "in"} },
        { "id": "e_6", "kind": "control",
          "from": {"node": "if1",  "port": "false"}, "to": {"node": "wh",   "port": "in"} },
        { "id": "e_7", "kind": "control",
          "from": {"node": "wh",   "port": "done"},  "to": {"node": "show", "port": "in"} },
        { "id": "e_8", "kind": "control",
          "from": {"node": "show", "port": "out"},   "to": {"node": "e",    "port": "in"} }
      ]
    }
  ]
}
