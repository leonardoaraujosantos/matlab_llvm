      fired = false;
      if r_chart_root == 2
        if ~fired && ev_arrived
          r_chart_root = 3;
          t_registering = tick_count;
          fired = true;
        end
      end
      if r_chart_root == 3
        if ~fired && ev_paid
          r_chart_root = 1;
          t_in_room = tick_count;
          l_room_key = 1;
          fired = true;
        end
      end
      if r_chart_root == 1
        if ~fired && ev_alarm_time
          l_wake_up = 1;
          fired = true;
