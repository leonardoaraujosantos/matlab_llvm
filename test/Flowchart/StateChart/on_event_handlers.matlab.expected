function [out_bell, out_lamp] = alarm_tick(ev_intruder, ev_all_clear, ev_test)
  persistent init_done;
  persistent r_chart_root;
  persistent l_bell;
  persistent l_lamp;
  if isempty(init_done)
    init_done = 0;
    r_chart_root = 0;
    l_bell = 0;
    l_lamp = 0;
  end
  if init_done == 0
    r_chart_root = 2;
    l_bell = 0; l_lamp = 0;
    init_done = 1;
  end
  fired = true;
  iter = 0;
  while fired
    if iter >= 1000
      fired = false;
    else
      iter = iter + 1;
      fired = false;
      if r_chart_root == 2
        if ~fired && ev_intruder && (l_lamp==1)
          r_chart_root = 1;
          l_bell = 1; l_lamp = 1;
          fired = true;
        end
        if ~fired && ev_test
          l_bell = 1; l_lamp = 1;
        end
        if ~fired && ev_intruder
          l_lamp = 1;
        end
      end
      if r_chart_root == 1
        if ~fired && ev_all_clear
          l_bell = 0;
          r_chart_root = 2;
          l_bell = 0; l_lamp = 0;
          fired = true;
        end
      end
    end
  end
  out_bell = l_bell;
  out_lamp = l_lamp;
end
