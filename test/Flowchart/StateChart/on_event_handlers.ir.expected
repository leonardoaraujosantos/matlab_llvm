ChartModel entry=alarm charts=1
Chart alarm sig=()->(bell,lamp) maxIter=1000
  symbol.data name=bell scope=output type=double initial=0
  symbol.data name=lamp scope=output type=double initial=0
  symbol.event name=intruder trigger=rising
  symbol.event name=all_clear trigger=rising
  symbol.event name=test trigger=rising
  State armed decomp=leaf initial
    .entry=bell = 0; lamp = 0
    .on(test)=bell = 1; lamp = 1
    .on(intruder)=lamp = 1
  State alarming decomp=leaf
    .entry=bell = 1; lamp = 1
    .exit=bell = 0
  Transition t_arm_alarm armed -> alarming kind=outer priority=1 event=intruder guard=lamp==1
  Transition t_alarm_arm alarming -> armed kind=outer priority=1 event=all_clear
