function [out_heat, out_fan_cmd] = heater_tick(in_temp, in_setpoint, ev_tick)
  persistent init_done;
  persistent r_chart_root;
  persistent r_fan;
  persistent r_thermo;
  persistent l_fan_cmd;
  persistent l_heat;
  if isempty(init_done)
    init_done = 0;
    r_chart_root = 0;
    r_fan = 0;
    r_thermo = 0;
    l_heat = 0;
    l_fan_cmd = 0;
  end
  l_temp = in_temp;
  l_setpoint = in_setpoint;
  if init_done == 0
    r_chart_root = 1;
    r_chart_root = 7;
    r_thermo = 5;
    l_heat = 1;
    r_chart_root = 2;
    r_fan = 3;
    l_fan_cmd = 0;
    init_done = 1;
  end
  fired = true;
  iter = 0;
  while fired
    if iter >= 1000
      fired = false;
    else
      iter = iter + 1;
      fired = false;
      if r_chart_root == 1
        if r_thermo == 5
          if ~fired && ev_tick && (l_temp >= l_setpoint + 2)
            r_thermo = 4;
            l_heat = 0;
            fired = true;
          end
        end
        if r_thermo == 4
          if ~fired && ev_tick && (l_temp <= l_setpoint - 2)
            r_thermo = 5;
            l_heat = 1;
            fired = true;
          end
        end
        if r_fan == 3
          if ~fired && ev_tick && (l_heat==1)
            r_fan = 6;
            l_fan_cmd = 1;
            fired = true;
          end
        end
        if r_fan == 6
          if ~fired && ev_tick && (l_heat==0)
            r_fan = 3;
            l_fan_cmd = 0;
            fired = true;
          end
        end
      end
    end
  end
  out_heat = l_heat;
  out_fan_cmd = l_fan_cmd;
end
