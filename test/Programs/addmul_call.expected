module {
  func.func @script() {
    %cst = arith.constant 2.000000e+00 : f64
    %cst_0 = arith.constant 3.000000e+00 : f64
    %cst_1 = arith.constant 4.000000e+00 : f64
    %0 = "matlab.call"(%cst, %cst_0, %cst_1) {callee = "addmul", matlab.name = "r"} : (f64, f64, f64) -> f64
    return
  }
  func.func @addmul(%arg0: f64 {matlab.name = "a"}, %arg1: f64 {matlab.name = "b"}, %arg2: f64 {matlab.name = "c"}) -> (f64 {matlab.name = "z"}) {
    %0 = arith.addf %arg0, %arg1 : f64
    %1 = arith.mulf %0, %arg2 : f64
    return %1 : f64
  }
}
