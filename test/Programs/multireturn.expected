module {
  func.func @script() {
    %cst = arith.constant 1.000000e+01 : f64
    %cst_0 = arith.constant 3.000000e+00 : f64
    %0:2 = "matlab.call"(%cst, %cst_0) {callee = "sumdiff", matlab.name = "y", nargout = 2 : i64} : (f64, f64) -> (f64, f64)
    return
  }
  func.func @sumdiff(%arg0: f64 {matlab.name = "a"}, %arg1: f64 {matlab.name = "b"}) -> (f64 {matlab.name = "s"}, f64 {matlab.name = "d"}) {
    %0 = arith.addf %arg0, %arg1 : f64
    %1 = arith.subf %arg0, %arg1 : f64
    return %0, %1 : f64, f64
  }
}
