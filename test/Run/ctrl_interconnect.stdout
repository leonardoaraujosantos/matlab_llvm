series Acl ([-1, 0; 1, -1]):
        -1         0
         1        -1
series eig (must both be -1):
        -1
        -1
parallel Acl (blkdiag(-1, -1)):
        -1         0
         0        -1
parallel Bcl ([1; 1]):
         1
         1
parallel Ccl ([1, 1]):
         1         1
series with -1 -3 plants — eig (must be {-3, -1}):
        -3
        -1
1-return series Acl (must match):
        -1         0
         1        -3
