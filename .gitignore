build/
# Auxiliary CMake build trees produced by alternate configurations
# (coverage, runtime-only, sym-enabled). Same artefacts as build/,
# different layout; ignore the same way.
build-*/
*.o
*.a
.cache/
compile_commands.json
.DS_Store
Testing/

# Native binaries left in the repo root by ad-hoc compile commands.
# The canonical artefacts live under build/; root-level copies are
# transient (matlabc helper scripts, runtime-test-* runners, the
# matlab-lsp executable, Clang's default.profraw coverage dump).
/matlabc
/matlab-lsp
/runtime-test-*
/default.profraw

# Native binaries built from examples/*.m by the helper scripts.
# Keep the .m sources and any markdown; drop the compiled artifacts.
# `.mflow` flowchart sources are also kept (examples/mflow/) along
# with their `blocks/` sidecar `.m` files.
examples/*
!examples/*.m
!examples/*.md
!examples/.gitignore
!examples/*/
examples/*/*
!examples/*/*.m
!examples/*/*.md
!examples/*/*.mflow
!examples/*/*/
examples/*/*/*
!examples/*/*/*.m
!examples/*/*/*.md
!examples/*/*/*.mflow
!examples/*/data/
!examples/*/data/*.png

# Stray CMake artifacts if someone configures from the repo root
# rather than build/ (canonical layout uses build/, see justfile).
/CMakeCache.txt
/CMakeFiles/
/CTestTestfile.cmake
/Makefile
/cmake_install.cmake

# Local Claude Code state (worktrees, transcripts, agent scratch)
.claude/

# Python bytecode caches from the test harness scripts
__pycache__/
*.pyc

# mflow-3d-animation example mesh fixtures (override the broad assets/ ignore)
!examples/mflowlink/3d/assets/
!examples/mflowlink/3d/assets/**
